START hilow_game

    # Establish a valid guessing range.
    OUTPUT "Enter the lower bound:"
    INPUT lower_bound

    OUTPUT "Enter the upper bound:"
    INPUT upper_bound

    WHILE lower_bound >= upper_bound
        OUTPUT "The lower bound must be less than the upper bound."
        OUTPUT "Enter the lower bound:"
        INPUT lower_bound
        OUTPUT "Enter the upper bound:"
        INPUT upper_bound
    END WHILE

    # Establish the number the player is trying to guess.
    SET random_number = RANDOM number between lower_bound and upper_bound

    # Play the game.
    OUTPUT "Enter a guess between", lower_bound, "and", upper_bound
    INPUT guess

    WHILE guess < lower_bound OR guess > upper_bound
        OUTPUT "Your guess must be between", lower_bound, "and", upper_bound
        OUTPUT "Enter another guess:"
        INPUT guess
    END WHILE

    WHILE guess != random_number
        IF guess < random_number THEN
            OUTPUT "Too low!"
        ELSE
            OUTPUT "Too high!"
        END IF

        OUTPUT "Enter another guess:"
        INPUT guess

        WHILE guess < lower_bound OR guess > upper_bound
            OUTPUT "Your guess must be between", lower_bound, "and", upper_bound
            OUTPUT "Enter another guess:"
            INPUT guess
        END WHILE

    END WHILE

    OUTPUT "Correct! You guessed the number!"

END hilow_game




